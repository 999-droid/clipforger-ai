# ==============================================================================
# ClipForge AI Environment Configuration
# Copy to .env (root / backend) and frontend/.env.local for local development
# ==============================================================================

ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000

# Set to true only if running without Redis/Celery worker (e.g., single-instance free tier)
USE_IN_PROCESS_WORKER=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=clips

# Redis & Celery (auto-derived from REDIS_URL if left empty)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Cloudflare R2 (Optional: falls back to Supabase Storage when left empty)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gaming-reel-clips
R2_PUBLIC_DOMAIN=

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Faster-Whisper Speech-to-Text
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Razorpay Payments (Optional unless enabling Pro subscriptions)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=
